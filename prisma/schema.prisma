// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Student {
  id             String   @id @default(cuid())
  serialNo       Int?
  name           String
  guardianName   String?
  dateOfBirth    String?
  gender         String?
  rollNumber     String   @unique
  regNumber      String?
  class          String
  academicYear   String
  stream         String?
  centreName     String?
  subjects       Subject[]
  result         Result?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Subject {
  id             String  @id @default(cuid())
  studentId      String
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectName    String
  theoryMarks    Int?    @default(0)
  practicalMarks Int?    @default(0)
  minMarks       Int
  maxMarks       Int
  obtainedMarks  Int
}

model Result {
  id             String    @id @default(cuid())
  studentId      String    @unique
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resultId       String    @unique @default(cuid())
  totalObtained  Int
  totalMax       Int
  percentage     Float
  status         String    // PASS | FAIL | REVOKED
  grade          String
  division       String
  issueDate      DateTime  @default(now())
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
